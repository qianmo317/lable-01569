# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=campus_user
DB_PASSWORD=campus_password
DB_DATABASE=campus_trading

# Database Options
# Set to 'true' to enable schema synchronization (NOT recommended for production)
DB_SYNCHRONIZE=false

# JWT Configuration
# IMPORTANT: Change this to a strong secret (at least 32 characters) in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Seed Configuration
# Set to 'true' to enable seeding in production (NOT recommended)
ENABLE_SEED=false

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (default: 100)
RATE_LIMIT_MAX=100
